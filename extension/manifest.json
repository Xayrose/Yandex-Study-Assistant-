{
  "manifest_version": 3,
  "name": "Yandex Study Assistant",
  "version": "4.0.0",
  "description": "Локальные решатели и быстрый облачный ИИ-помощник для заданий Яндекс Учебника.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://education.yandex.ru/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Yandex Study Assistant"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://education.yandex.ru/*"
      ],
      "js": [
        "rules.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}